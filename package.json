{
  "name": "antra-sdk",
  "version": "0.0.1",
  "private": false,
  "description": "The AI SDK for building type-safe, multi-provider AI applications with minimal boilerplate.",
  "license": "MIT",
  "author": "Ved Pandey",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "ai",
    "sdk",
    "agent",
    "llm",
    "openai",
    "anthropic",
    "typescript",
    "type-safe",
    "zod"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.9.6",
    "tsup": "^8.3.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
